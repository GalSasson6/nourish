# Copy this file to `.env` and fill in your values. Never commit `.env`.

# One or more Gemini API keys, comma-separated. Keys are rotated per request and used as failover.
GEMINI_API_KEYS=your-key-1,your-key-2

# API server port.
PORT=8787

# Address the API server binds to (default 127.0.0.1).
# Set it to a LAN or Tailscale IP to reach the app from your phone.
API_HOST=127.0.0.1

# Address the Vite dev server binds to (default localhost), plus any extra
# hostnames it should accept (comma-separated).
DEV_HOST=localhost
DEV_ALLOWED_HOSTS=
